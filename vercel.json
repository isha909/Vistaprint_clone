{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/$",
      "dest": "/api/index.php"
    },
    {
      "src": "/(category|subcategory|view-all|help|cart|checkout|product|search|login|register|track-order)",
      "dest": "/api/$1.php"
    }
  ]
}